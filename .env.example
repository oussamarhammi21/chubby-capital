# Clé API Anthropic pour le coach Claude des versions IA (facultatif).
# Sans clé, l'arène tourne normalement et les versions IA gardent leurs réglages.
ANTHROPIC_API_KEY=

# Ton vrai compte chez Interactive Brokers (page « Mon vrai compte »). IB Gateway doit tourner sur ce PC.
# Port 4002 = compte papier d'IB Gateway (argent fictif), 4001 = vrai compte. TWS : 7497 papier, 7496 réel.
# Dans Docker, IB Gateway tourne sur la machine hôte : IBKR_HOST=host.docker.internal
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
# Code demandé pour changer les réglages du vrai compte depuis un autre appareil (téléphone, Tailscale).
# Sans code, ces réglages ne se changent que depuis ce PC. Le bouton Stop marche toujours, partout.
CHUBBY_PIN=
